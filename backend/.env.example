# Скопируйте в backend/.env и заполните. При первом `python -m app.seed` файл создаётся сам.
DEBUG=true
# Обязательно длинный случайный ключ в продакшене: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# В продакшене — PostgreSQL:
# DATABASE_URL=postgresql+psycopg://memor:password@localhost:5432/memor
# MEDIA_DIR=/var/www/memor/media
# MATERIALS_DIR=/path/to/client/materials   # папки с фото и .pptx — нужны только для сида

# Первый администратор (создаётся сидом, если пользователей ещё нет)
ADMIN_EMAIL=admin@memor.uz
ADMIN_PASSWORD=

# Cookie админки только по HTTPS — включите на боевом домене (заодно бэкенд начнёт слать HSTS)
COOKIE_SECURE=false
# Сессия админки истекает по времени: после SESSION_IDLE_MINUTES без действий
# и в любом случае через ACCESS_TOKEN_HOURS после входа
SESSION_IDLE_MINUTES=60
ACCESS_TOKEN_HOURS=12
# Часовой пояс времени в выгрузке заявок (CSV), часы от UTC; 5 — Ташкент
EXPORT_UTC_OFFSET_HOURS=5

# Прокси, которым верим в X-Forwarded-For (IP или подсети через запятую): по этому адресу считаются
# лимиты входа и заявок. По умолчанию — Next.js/nginx на этом же сервере. Пусто — заголовок не читается
# (бэкенд открыт наружу без прокси). uvicorn запускайте с тем же списком: --forwarded-allow-ips.
TRUSTED_PROXIES=127.0.0.1,::1

# Исходящие запросы интеграций (CRM MEMOR, вебхук) — защита от SSRF: только https и только публичные адреса.
# Для разработки, когда CRM запущена на этом же компьютере:
# INTEGRATIONS_ALLOW_HTTP=true
# INTEGRATIONS_ALLOWED_HOSTS=127.0.0.1,localhost
# В продакшене, если CRM в локальной сети: INTEGRATIONS_ALLOWED_HOSTS=crm.internal (только её хост)
INTEGRATIONS_ALLOW_HTTP=false
INTEGRATIONS_ALLOWED_HOSTS=

# Почта для заявок (получатели указываются в админке → Интеграции)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
